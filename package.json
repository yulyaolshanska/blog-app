{
  "name": "blog-app",
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prettier": "prettier \"**/*.{js,ts,tsx,json,css,html,md}\" --write",
    "git:hook:precommit": "lint-staged",
    "test": "echo \"Error: no test specified\" && exit 1",
    "ci:prepare": "simple-git-hooks",
    "lint:editor": "editorconfig-checker",
    "lint:fs": "ls-lint",
    "lint:type": "npx tsc --noEmit",
    "lint:js": "npx eslint . --max-warnings=0 --no-warn-ignored",
    "lint:format": "prettier --check \"**/*.{ts,tsx,json,md,css,html}\"",
    "lint:trash": "knip",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --workspace apps/backend run start:dev",
    "dev:frontend": "npm --workspace apps/frontend run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm --workspace apps/frontend run build",
    "build:backend": "npm --workspace apps/backend run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "simple-git-hooks": {
    "pre-commit": "npm run lint:type && npm run git:hook:precommit"
  },
  "devDependencies": {
    "@ls-lint/ls-lint": "^2.3.0",
    "concurrently": "^9.1.2",
    "knip": "^5.51.1"
  }
}
